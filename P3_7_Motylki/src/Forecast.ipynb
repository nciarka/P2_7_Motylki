   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.linear_model import LinearRegression\n",
    "\n",
    "# 1. trend po gatunkach\n",
    "species_trend = df.groupby([\"genus_species\", \"year\"])[\"count\"].mean().reset_index()\n",
    "\n",
    "# 2. liczymy slope (czy rośnie czy spada)\n",
    "results = []\n",
    "\n",
    "for species in species_trend[\"genus_species\"].unique():\n",
    "    temp = species_trend[species_trend[\"genus_species\"] == species]\n",
    "    \n",
    "    X = temp[\"year\"].values.reshape(-1, 1)\n",
    "    y = temp[\"count\"].values\n",
    "    \n",
    "    model = LinearRegression()\n",
    "    model.fit(X, y)\n",
    "    \n",
    "    slope = model.coef_[0]\n",
    "    results.append((species, slope))\n",
    "\n",
    "trend_df = pd.DataFrame(results, columns=[\"species\", \"trend_slope\"])\n",
    "\n",
    "# 3. wybieramy TOP rosnące i spadające\n",
    "top_pos = trend_df.sort_values(\"trend_slope\", ascending=False).head(10)\n",
    "top_neg = trend_df.sort_values(\"trend_slope\", ascending=True).head(10)\n",
    "\n",
    "plot_df = pd.concat([top_pos, top_neg]).sort_values(\"trend_slope\")\n",
    "\n",
    "# 4. wykres\n",
    "plt.figure(figsize=(10,6))\n",
    "plt.barh(plot_df[\"species\"], plot_df[\"trend_slope\"])\n",
    "plt.title(\"Trend gatunków (wzrost / spadek liczebności)\")\n",
    "plt.xlabel(\"Trend (slope)\")\n",
    "plt.ylabel(\"Gatunek\")\n",
    "\n",
    "plt.show()"
   ]
